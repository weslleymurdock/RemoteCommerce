@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">RemoteCommerce</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4">Administration</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="2">
        <MudNavMenu Class="pa-3">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Settings">Site settings</MudNavLink>
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>
            <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.Security">Roles & permissions</MudNavLink>
            <MudNavLink Href="/admin/localization" Icon="@Icons.Material.Filled.Translate">Localization</MudNavLink>
            <MudNavLink Href="/admin/security" Icon="@Icons.Material.Filled.Lock">Security & configuration</MudNavLink>
            <MudNavLink Href="/plugins" Icon="@Icons.Material.Filled.Extension">Plugins</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>
