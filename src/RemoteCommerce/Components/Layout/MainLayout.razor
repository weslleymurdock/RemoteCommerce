@inherits LayoutComponentBase
@inject IMenuProvider MenuProvider
@inject IThemeProvider ThemeProvider
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILocalizer Localizer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout class="rc-theme-@ThemeProvider.Current.Id">
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">RemoteCommerce</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4">@Localizer.Get<CatalogResources>("Admin.Administration")</MudText>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="2">
        <MudNavMenu Class="pa-3">
            @foreach (var item in MenuProvider.GetItems((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User))
            {
                <MudNavLink Href="@item.Route" Match="NavLinkMatch.Prefix" Icon="@item.Icon">@Localizer.Get<CatalogResources>(item.LabelResourceKey)</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>
