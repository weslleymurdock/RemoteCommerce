@inherits LayoutComponentBase
@inject IAdminNavigationRegistry AdminNavigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">RemoteCommerce</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-4">Administration</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="2">
        <MudNavMenu Class="pa-3">
            @foreach (var item in AdminNavigation.GetItems())
            {
                <MudNavLink Href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@item.Icon">@item.Title</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>
</MudLayout>
