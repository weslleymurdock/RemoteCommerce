@page "/plugins"
@attribute [Authorize(Policy = AuthorizationPolicies.ManagePlugins)]
@using Microsoft.AspNetCore.Authorization
@using RemoteCommerce.Application.Identity
@using RemoteCommerce.Plugins
@inject PluginManagementService PluginManagement
@inject PluginInstallationService PluginInstallation
@inject IApplicationRestartService RestartService
@inject ISnackbar Snackbar

<PageTitle>Plugins - RemoteCommerce</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4">Plugins</MudText>
            <MudText Typo="Typo.body2">Install, validate, update and manage RemoteCommerce extensions without editing application files.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_loading">Refresh</MudButton>
    </MudStack>

    @if (RestartService.Status.Required)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            <MudText Typo="Typo.subtitle2">Restart required</MudText>
            <MudText Typo="Typo.body2">@RestartService.Status.Reason</MudText>
            <MudText Typo="Typo.caption">The current dependency injection container is unchanged. Restart the host to apply the pending lifecycle operation.</MudText>
        </MudAlert>
    }

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6">Package</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
            <InputFile OnChange="OnPackageSelected" accept=".nupkg" />
            <MudButton Variant="Variant.Outlined" Disabled="@(_selectedFile is null || _busy)" OnClick="ValidateSelectedAsync">Validate</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedFile is null || _busy)" OnClick="InstallAsync">Install</MudButton>
            @if (_busy) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">Selected: @(_selectedFile?.Name ?? "No package selected")</MudText>
        @if (_validation is not null)
        {
            <MudAlert Severity="@(_validation.IsValid ? Severity.Success : Severity.Error)" Class="mt-2">
                <MudText Typo="Typo.subtitle2">Package validation: @(_validation.IsValid ? "passed" : "failed")</MudText>
                @if (_validation.Manifest is not null)
                {
                    <MudText Typo="Typo.body2">@_validation.Manifest.Name @_validation.Manifest.Version — SHA-256 @_validation.PackageHash</MudText>
                }
                @foreach (var issue in _validation.Issues)
                {
                    <MudText Typo="Typo.caption">[@issue.Code] @issue.Message</MudText>
                }
            </MudAlert>
        }
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_plugins.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No plugins are installed.</MudAlert>
    }
    else
    {
        @foreach (var plugin in _plugins)
        {
            <MudExpansionPanel Text="@plugin.Name">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1">@plugin.Name</MudText>
                        <MudChip T="string" Size="Size.Small">@plugin.Version</MudChip>
                        <MudChip T="PluginInstallationState" Color="@StateColor(plugin.State)" Size="Size.Small">@plugin.State</MudChip>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.h6">Plugin information</MudText>
                            <MudText><b>Plugin ID:</b> @plugin.PluginId</MudText>
                            <MudText><b>Package:</b> @plugin.PackageId</MudText>
                            <MudText><b>Title:</b> @plugin.Title</MudText>
                            <MudText><b>Version:</b> @plugin.Version</MudText>
                            <MudText><b>Authors:</b> @plugin.Authors</MudText>
                            <MudText><b>Company:</b> @plugin.Company</MudText>
                            <MudText><b>Description:</b> @plugin.Description</MudText>
                            <MudText><b>Desired state:</b> @plugin.DesiredState</MudText>
                            <MudText><b>Package SHA-256:</b> @plugin.PackageHash</MudText>
                            <MudText><b>Repository:</b> @plugin.RepositoryUrl</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.h6">Dependencies</MudText>
                            @if (plugin.Dependencies.Count == 0)
                            {
                                <MudText Typo="Typo.body2">No plugin dependencies declared.</MudText>
                            }
                            else
                            {
                                @foreach (var dependency in plugin.Dependencies)
                                {
                                    <MudText Typo="Typo.body2">@dependency.DependencyPluginId &ge; @dependency.MinimumVersion @((dependency.MaximumVersion is null) ? string.Empty : $"&lt; {dependency.MaximumVersion}")</MudText>
                                }
                            }
                            @if (plugin.LatestError is not null)
                            {
                                <MudAlert Severity="Severity.Error" Class="mt-2">
                                    <MudText Typo="Typo.subtitle2">Activation error</MudText>
                                    <MudText Typo="Typo.caption">[@plugin.LatestError.Category] @plugin.LatestError.Message</MudText>
                                </MudAlert>
                            }
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @if (plugin.DesiredState == PluginDesiredState.Enabled)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => DisableAsync(plugin.PluginId))">Disable</MudButton>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EnableAsync(plugin.PluginId))">Enable</MudButton>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_selectedFile is null || _busy)" OnClick="@(() => UpdateAsync(plugin.PluginId))">Update with selected package</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => UninstallAsync(plugin.PluginId))">Uninstall</MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTabs>
                                <MudTabPanel Text="README.md">
                                    @if (_documentation.TryGetValue(plugin.PluginId, out var documentation))
                                    {
                                        <MudPaper Class="pa-3" Outlined="true" Style="white-space: pre-wrap; max-height: 360px; overflow-y: auto;">@documentation.Readme</MudPaper>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => LoadDocumentationAsync(plugin.PluginId))">Load README</MudButton>
                                    }
                                </MudTabPanel>
                                <MudTabPanel Text="LICENSE.md">
                                    @if (_documentation.TryGetValue(plugin.PluginId, out var licenseDocumentation))
                                    {
                                        <MudPaper Class="pa-3" Outlined="true" Style="white-space: pre-wrap; max-height: 360px; overflow-y: auto;">@licenseDocumentation.License</MudPaper>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => LoadDocumentationAsync(plugin.PluginId))">Load LICENSE</MudButton>
                                    }
                                </MudTabPanel>
                            </MudTabs>
                        </MudItem>
                    </MudGrid>
                </ChildContent>
            </MudExpansionPanel>
        }
    }
</MudStack>

@code {
    private IReadOnlyList<PluginInformation> _plugins = [];
    private readonly Dictionary<string, PluginDocumentation> _documentation = new(StringComparer.OrdinalIgnoreCase);
    private IBrowserFile? _selectedFile;
    private PluginPackageValidationResult? _validation;
    private bool _loading;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private void OnPackageSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _validation = null;
    }

    private async Task ValidateSelectedAsync()
    {
        if (_selectedFile is null) return;
        _busy = true;
        try
        {
            var path = await CopySelectedPackageAsync();
            try { _validation = await PluginInstallation.ValidatePackageAsync(path); }
            finally { DeleteTemporary(path); }
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task InstallAsync()
    {
        if (_selectedFile is null) return;
        _busy = true;
        try
        {
            var path = await CopySelectedPackageAsync();
            try
            {
                await PluginInstallation.InstallAsync(path);
                Snackbar.Add("Plugin installed. Restart the application to activate it.", Severity.Success);
                _selectedFile = null;
                _validation = null;
                await RefreshAsync();
            }
            finally { DeleteTemporary(path); }
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task UpdateAsync(string pluginId)
    {
        if (_selectedFile is null) return;
        _busy = true;
        try
        {
            var path = await CopySelectedPackageAsync();
            try
            {
                await PluginInstallation.UpdateAsync(pluginId, path);
                Snackbar.Add("Plugin update staged. Restart the application to activate the new version.", Severity.Success);
                _selectedFile = null;
                _validation = null;
                await RefreshAsync();
            }
            finally { DeleteTemporary(path); }
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task EnableAsync(string pluginId) { await RunLifecycleAsync(() => PluginManagement.EnableAsync(pluginId), "Plugin enabled for the next restart."); }
    private async Task DisableAsync(string pluginId) { await RunLifecycleAsync(() => PluginManagement.DisableAsync(pluginId), "Plugin disabled for the next restart."); }
    private async Task UninstallAsync(string pluginId) { await RunLifecycleAsync(() => PluginManagement.UninstallAsync(pluginId), "Plugin uninstalled. Restart the application to remove its loaded assembly."); }

    private async Task RunLifecycleAsync(Func<Task> operation, string successMessage)
    {
        try { await operation(); Snackbar.Add(successMessage, Severity.Success); await RefreshAsync(); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
    }

    private async Task LoadDocumentationAsync(string pluginId)
    {
        try { _documentation[pluginId] = await PluginManagement.GetDocumentationAsync(pluginId); }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try { _plugins = await PluginManagement.ListAsync(); }
        finally { _loading = false; }
    }

    private async Task<string> CopySelectedPackageAsync()
    {
        if (_selectedFile is null) throw new InvalidOperationException("No plugin package is selected.");
        var directory = Path.Combine(Path.GetTempPath(), "RemoteCommerce", "plugins-ui");
        Directory.CreateDirectory(directory);
        var path = Path.Combine(directory, $"{Guid.NewGuid():N}.nupkg");
        await using var input = _selectedFile.OpenReadStream(100_000_000);
        await using var output = File.Create(path);
        await input.CopyToAsync(output);
        return path;
    }

    private static void DeleteTemporary(string path)
    {
        try { if (File.Exists(path)) File.Delete(path); } catch { }
    }

    private static Color StateColor(PluginInstallationState state) => state switch
    {
        PluginInstallationState.Loaded => Color.Success,
        PluginInstallationState.Failed => Color.Error,
        PluginInstallationState.ActivationPending => Color.Warning,
        PluginInstallationState.Disabled => Color.Default,
        _ => Color.Info
    };
}
