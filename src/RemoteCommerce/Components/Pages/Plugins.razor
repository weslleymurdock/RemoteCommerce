@page "/plugins"
@using RemoteCommerce.Plugins
@inject PluginManagementService PluginManagement
@inject PluginInstallationService PluginInstallation
@inject ISnackbar Snackbar

<PageTitle>Plugins - RemoteCommerce</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Plugins</MudText>
    <MudText Typo="Typo.body2">Install .nupkg extensions, inspect package information, manage persisted state, and restart the application to apply DI changes.</MudText>
    <MudPaper Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <InputFile OnChange="OnPackageSelected" accept=".nupkg" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedFile is null || _busy)" OnClick="InstallAsync">Install plugin</MudButton>
            @if (_busy) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">Selected: @(_selectedFile?.Name ?? "No package selected")</MudText>
    </MudPaper>
    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else if (_plugins.Count == 0) { <MudAlert Severity="Severity.Info">No plugins are installed.</MudAlert> }
    else
    {
        @foreach (var plugin in _plugins)
        {
            <MudExpansionPanel Text="@plugin.Name" Expanded="@(_expandedPluginId == plugin.PluginId)" ExpandedChanged="@(expanded => OnExpandedChangedAsync(plugin.PluginId, expanded))">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1">@plugin.Name</MudText>
                        <MudChip T="string" Size="Size.Small">@plugin.Version</MudChip>
                        <MudChip T="PluginInstallationState" Color="@(plugin.State == PluginInstallationState.Installed ? Color.Success : Color.Default)" Size="Size.Small">@plugin.State</MudChip>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.h6">Package information</MudText>
                            <MudText><b>Package:</b> @plugin.PackageId</MudText>
                            <MudText><b>Title:</b> @plugin.Title</MudText>
                            <MudText><b>Authors:</b> @plugin.Authors</MudText>
                            <MudText><b>Company:</b> @plugin.Company</MudText>
                            <MudText><b>Tags:</b> @plugin.PackageTags</MudText>
                            <MudText><b>Repository:</b> @plugin.RepositoryUrl</MudText>
                            <MudText><b>Project:</b> @plugin.PackageProjectUrl</MudText>
                            <MudText><b>License acceptance:</b> @plugin.PackageRequireLicenseAcceptance</MudText>
                            <MudText Class="mt-2">@plugin.Description</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (_documentation.TryGetValue(plugin.PluginId, out var documentation))
                            {
                                <MudText Typo="Typo.h6">README.md</MudText>
                                <MudPaper Class="pa-3 mb-4" Outlined="true" Style="white-space: pre-wrap; max-height: 320px; overflow-y: auto;">@documentation.Readme</MudPaper>
                                <MudText Typo="Typo.h6">LICENSE.md</MudText>
                                <MudPaper Class="pa-3" Outlined="true" Style="white-space: pre-wrap; max-height: 320px; overflow-y: auto;">@documentation.License</MudPaper>
                            }
                            else { <MudProgressCircular Indeterminate="true" /> }
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudStack Row="true" Spacing="1">
                                @if (plugin.State == PluginInstallationState.Installed)
                                { <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => DisableAsync(plugin.PluginId))">Disable</MudButton> }
                                else
                                { <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => EnableAsync(plugin.PluginId))">Enable</MudButton> }
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => UninstallAsync(plugin.PluginId))">Uninstall</MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </ChildContent>
            </MudExpansionPanel>
        }
    }
    <MudAlert Severity="Severity.Info">Plugin installation, enable/disable, and uninstall operations are persisted immediately. Restart the application before expecting plugin services to change in the dependency injection container.</MudAlert>
</MudStack>

@code {
    private IReadOnlyList<PluginInformation> _plugins = [];
    private readonly Dictionary<string, PluginDocumentation> _documentation = new(StringComparer.OrdinalIgnoreCase);
    private IBrowserFile? _selectedFile;
    private string? _expandedPluginId;
    private bool _loading;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();
    private void OnPackageSelected(InputFileChangeEventArgs args) => _selectedFile = args.File;

    private async Task OnExpandedChangedAsync(string pluginId, bool expanded)
    {
        _expandedPluginId = expanded ? pluginId : null;
        if (expanded && !_documentation.ContainsKey(pluginId))
        {
            try { _documentation[pluginId] = await PluginManagement.GetDocumentationAsync(pluginId); }
            catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        }
    }

    private async Task InstallAsync()
    {
        if (_selectedFile is null) return;
        _busy = true;
        try
        {
            var directory = Path.Combine(Path.GetTempPath(), "RemoteCommerce", "plugins-ui");
            Directory.CreateDirectory(directory);
            var path = Path.Combine(directory, $"{Guid.NewGuid():N}.nupkg");
            await using (var input = _selectedFile.OpenReadStream(100_000_000))
            await using (var output = File.Create(path)) await input.CopyToAsync(output);
            await PluginInstallation.InstallAsync(path);
            Snackbar.Add("Plugin installed. Restart the application to activate it.", Severity.Success);
            File.Delete(path); _selectedFile = null; await RefreshAsync();
        }
        catch (Exception exception) { Snackbar.Add(exception.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task DisableAsync(string pluginId) { await PluginManagement.DisableAsync(pluginId); Snackbar.Add("Plugin disabled for the next restart.", Severity.Info); await RefreshAsync(); }
    private async Task EnableAsync(string pluginId) { await PluginManagement.EnableAsync(pluginId); Snackbar.Add("Plugin enabled for the next restart.", Severity.Success); await RefreshAsync(); }
    private async Task UninstallAsync(string pluginId) { await PluginManagement.UninstallAsync(pluginId); _documentation.Remove(pluginId); Snackbar.Add("Plugin uninstalled. Restart the application to remove its loaded assembly.", Severity.Success); await RefreshAsync(); }
    private async Task RefreshAsync() { _loading = true; try { _plugins = await PluginManagement.ListAsync(); } finally { _loading = false; } }
}
