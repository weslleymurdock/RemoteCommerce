@page "/admin/catalog/categories"
@page "/admin/catalog/brands"
@page "/admin/catalog/tags"
@page "/admin/catalog/attributes"
@attribute [Authorize(Policy = AuthorizationPolicies.Administrator)]
@inject IMediator Mediator
@inject ILocalizer Localizer
@inject NavigationManager Navigation

<PageTitle>
    @Title
</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">
        @Title
    </MudText>

    @if (IsCategories)
    {
        <MudTable
            Items="categories"
            Dense="true">
            <HeaderContent>
                <MudTh>
                    @Get("Catalog.Name")
                </MudTh>
                <MudTh>
                    @Get("Catalog.Slug")
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Name
                </MudTd>
                <MudTd>
                    @context.Slug
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (IsBrands)
    {
        <MudTable
            Items="brands"
            Dense="true">
            <HeaderContent>
                <MudTh>
                    @Get("Catalog.Name")
                </MudTh>
                <MudTh>
                    @Get("Catalog.Slug")
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Name
                </MudTd>
                <MudTd>
                    @context.Slug
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (IsTags)
    {
        <MudTable
            Items="tags"
            Dense="true">
            <HeaderContent>
                <MudTh>
                    @Get("Catalog.Name")
                </MudTh>
                <MudTh>
                    @Get("Catalog.Slug")
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Name
                </MudTd>
                <MudTd>
                    @context.Slug
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else
    {
        <MudTable
            Items="attributes"
            Dense="true">
            <HeaderContent>
                <MudTh>
                    @Get("Catalog.Name")
                </MudTh>
                <MudTh>
                    @Get("Catalog.Values")
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.Name
                </MudTd>
                <MudTd>
                    @string.Join(", ", context.Values.Select(x => x.Value))
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<CategoryModel> categories = [];
    private IReadOnlyList<BrandModel> brands = [];
    private IReadOnlyList<TagModel> tags = [];
    private IReadOnlyList<AttributeModel> attributes = [];

    private bool IsCategories =>
        Navigation.Uri.Contains(
            "/categories",
            StringComparison.OrdinalIgnoreCase);

    private bool IsBrands =>
        Navigation.Uri.Contains(
            "/brands",
            StringComparison.OrdinalIgnoreCase);

    private bool IsTags =>
        Navigation.Uri.Contains(
            "/tags",
            StringComparison.OrdinalIgnoreCase);

    private string Title
    {
        get
        {
            if (IsCategories)
            {
                return Get("Catalog.Categories");
            }

            if (IsBrands)
            {
                return Get("Catalog.Brands");
            }

            if (IsTags)
            {
                return Get("Catalog.Tags");
            }

            return Get("Catalog.Attributes");
        }
    }

    private string Get(string key)
    {
        return Localizer.Get<CatalogResources>(key);
    }

    protected override async Task OnInitializedAsync()
    {
        var categoriesResult = await Mediator.Send(
            new GetCategoriesQuery());
        var brandsResult = await Mediator.Send(
            new GetBrandsQuery());
        var tagsResult = await Mediator.Send(
            new GetTagsQuery());
        var attributesResult = await Mediator.Send(
            new GetAttributesQuery());

        if (categoriesResult.Succeeded && categoriesResult.Value is not null)
        {
            categories = categoriesResult.Value;
        }

        if (brandsResult.Succeeded && brandsResult.Value is not null)
        {
            brands = brandsResult.Value;
        }

        if (tagsResult.Succeeded && tagsResult.Value is not null)
        {
            tags = tagsResult.Value;
        }

        if (attributesResult.Succeeded && attributesResult.Value is not null)
        {
            attributes = attributesResult.Value;
        }
    }
}
