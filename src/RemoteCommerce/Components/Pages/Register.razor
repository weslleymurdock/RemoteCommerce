@page "/register"
<PageTitle>Register user | RemoteCommerce</PageTitle>
<AuthorizeView Policy="ManageUsers"><Authorized><MudContainer MaxWidth="MaxWidth.Small" Class="mt-16"><MudPaper Class="pa-8"><MudText Typo="Typo.h5">Register user</MudText><MudTextField @bind-Value="_displayName" Label="Display name" Class="mt-4"/><MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Class="mt-4"/><MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Class="mt-4"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" OnClick="SubmitAsync">Create user</MudButton>@if(_message is not null){<MudAlert Severity="MudSeverity.Info" Class="mt-4">@_message</MudAlert>}</MudPaper></MudContainer></Authorized></AuthorizeView>
@code { private string _displayName=string.Empty,_email=string.Empty,_password=string.Empty; private string? _message; private async Task SubmitAsync(){try{await JS.InvokeAsync<object>("remoteCommerceIdentity.register",_email,_displayName,_password);_message="User created. A confirmation email was requested.";}catch(JSException ex){_message=ex.Message;}} }
