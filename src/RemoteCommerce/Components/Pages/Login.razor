@page "/login"

<PageTitle>Sign in | RemoteCommerce</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16"><MudPaper Elevation="4" Class="pa-8"><MudText Typo="Typo.h4">Sign in</MudText>@if(!_requiresTwoFactor){<MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Required="true" Class="mt-4"/><MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Required="true" Class="mt-4"/><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6" OnClick="LoginAsync" Disabled="_busy">Sign in</MudButton><MudLink Href="/forgot-password" Class="d-block mt-4">Forgot your password?</MudLink>}else{<MudText Typo="Typo.body2" Class="mt-4">Enter your authenticator code.</MudText><MudTextField @bind-Value="_code" Label="Authenticator code" InputType="InputType.Number" Class="mt-4"/><MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6" OnClick="TwoFactorAsync" Disabled="_busy">Verify</MudButton><MudTextField @bind-Value="_recoveryCode" Label="Recovery code" Class="mt-4"/><MudButton Variant="Variant.Text" FullWidth="true" OnClick="RecoveryAsync" Disabled="_busy">Use recovery code</MudButton>}@if(_error is not null){<MudAlert Severity="MudSeverity.Error" Class="mt-4">@_error</MudAlert>}</MudPaper></MudContainer>
@code { private string _email=string.Empty,_password=string.Empty,_code=string.Empty,_recoveryCode=string.Empty; private string? _error; private bool _busy,_requiresTwoFactor; private async Task LoginAsync(){await Execute(async()=>{var result=await JS.InvokeAsync<JsonElement>("remoteCommerceIdentity.login",_email,_password);if(result.TryGetProperty("requiresTwoFactor",out var twoFactor)&&twoFactor.GetBoolean()){_requiresTwoFactor=true;return;}Navigation.NavigateTo("/",true);});} private async Task TwoFactorAsync()=>await Execute(async()=>{await JS.InvokeAsync<object>("remoteCommerceIdentity.login2fa",_email,_code,false);Navigation.NavigateTo("/",true);}); private async Task RecoveryAsync()=>await Execute(async()=>{await JS.InvokeAsync<object>("remoteCommerceIdentity.loginRecovery",_email,_recoveryCode);Navigation.NavigateTo("/",true);}); private async Task Execute(Func<Task> action){_busy=true;_error=null;try{await action();}catch(JSException ex){_error=ex.Message;}finally{_busy=false;}} }
