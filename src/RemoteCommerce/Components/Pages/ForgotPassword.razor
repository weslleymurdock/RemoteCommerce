@page "/forgot-password"
<PageTitle>Forgot password | RemoteCommerce</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16"><MudPaper Class="pa-8"><MudText Typo="Typo.h5">Forgot your password?</MudText><MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Class="mt-4"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" OnClick="SubmitAsync" Disabled="_busy">Send recovery email</MudButton>@if(_message is not null){<MudAlert Severity="MudSeverity.Info" Class="mt-4">@_message</MudAlert>}</MudPaper></MudContainer>
@code { private string _email=string.Empty; private string? _message; private bool _busy; private async Task SubmitAsync(){_busy=true;try{await JS.InvokeAsync<object>("remoteCommerceIdentity.forgotPassword",_email);_message="If the account exists, a recovery message has been sent.";}catch(JSException ex){_message=ex.Message;}finally{_busy=false;}} }
