@page "/"

<PageTitle>RemoteCommerce</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <MudPaper Elevation="2" Class="pa-8">
        <MudText Typo="Typo.h3" GutterBottom="true">RemoteCommerce</MudText>
        <MudText Typo="Typo.body1">A modern .NET foundation for store management and extensibility.</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-6">
            <MudButton Href="/admin" Variant="Variant.Filled" Color="Color.Primary">Administration</MudButton>
            <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary">Sign in</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
