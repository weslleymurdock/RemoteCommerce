@page "/reset-password"
@page "/reset-password/{Email}/{Token}"
<PageTitle>Reset password | RemoteCommerce</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16"><MudPaper Class="pa-8"><MudText Typo="Typo.h5">Reset password</MudText><MudTextField @bind-Value="_password" Label="New password" InputType="InputType.Password" Class="mt-4"/><MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" OnClick="SubmitAsync">Reset password</MudButton>@if(_message is not null){<MudAlert Severity="MudSeverity.Info" Class="mt-4">@_message</MudAlert>}</MudPaper></MudContainer>
@code { [SupplyParameterFromQuery] private string? Email {get;set;} [SupplyParameterFromQuery] private string? Token {get;set;} private string _password=string.Empty; private string? _message; private async Task SubmitAsync(){try{await JS.InvokeAsync<object>("remoteCommerceIdentity.resetPassword",Email,Token,_password);_message="Password changed. You can now sign in.";}catch(JSException ex){_message=ex.Message;}} }
