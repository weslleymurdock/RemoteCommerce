{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Commerce": "Server=(localdb)\\MSSQLLocalDB;Database=RemoteCommerce;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Persistence": {
    "Database": {
      "Provider": "SqlServer",
      "Topology": "Single",
      "PrimaryConnectionName": "Commerce",
      "ReplicaConnectionName": "Replica"
    }
  },
  "Media": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootDirectory": "App_Data/media"
    },
    "MongoGridFs": {
      "DatabaseName": "RemoteCommerceMedia",
      "BucketName": "media"
    }
  },
  "DatabaseSetup": {
    "StateFile": "App_Data/database-setup-state.json"
  },
  "Jwt": {
    "Issuer": "RemoteCommerce",
    "Audience": "RemoteCommerce",
    "ExpirationMinutes": 60,
    "Key": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PluginAdministration": {
    "TrustedPackageDirectory": ""
  }
}
